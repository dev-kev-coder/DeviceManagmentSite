## Ignore Visual Studio temporary files, build results, and
## user-specific files

# Build results
bin/
obj/
[Bb]uild/
[Ll]og/
*.log

# User-specific files
*.user
*.suo
*.userosscache
*.sln.docstates

# ASP.NET Scaffolding
ScaffoldingReadMe.txt

# Project-specific
*.db
*.sqlite
*.pdb
*.mdb
*.bak

# Rider IDE files
.idea/
*.sln.iml

# Visual Studio Code
.vscode/

# Dotnet CLI
project.lock.json
project.fragment.lock.json
artifacts/

# NuGet
*.nupkg
**/packages/*
!**/packages/build/
!**/packages/repositories.config
.nuget/
package-lock.json
packages.config

# Environment files
.env
.env.*

# Azure Pipelines
.azure-pipelines/
*.azure-pipelines.yml

# Logs
*.log
logs/

# OS generated files
.DS_Store
Thumbs.db

# Publish output
publish/
out/

# Test results
TestResults/
*.trx
*.coverage
*.coveragexml

# Resharper
_ReSharper*/
*.DotSettings.user

# Global JetBrains Rider settings
.idea/

# IIS Express
.vs/
*.iisexpress

# Backup & restore
*.bak
*.orig

# Local development secrets
secrets.json

# Entity Framework Core Migrations
Migrations/

# Node.js (if using frontend or tools)
node_modules/
npm-debug.log
yarn-error.log
.pnp.*
.pnp

# Optional: Docker
docker-compose.override.yml
docker-compose.override.*.yml
